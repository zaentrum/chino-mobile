<?xml version="1.0" encoding="utf-8"?>
<!-- Inter Medium alone: a title set in it (the bar's, the full controls'
     toolbar's) is medium whatever weight the view asks for. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/inter_variable"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        app:font="@font/inter_variable"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:fontVariationSettings="'wght' 500" />
</font-family>
